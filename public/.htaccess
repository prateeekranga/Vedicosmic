Options -MultiViews
RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.vedicosmic\.com$ [NC]
RewriteRule ^(.*)$ https://vedicosmic.com/$1 [R=301,L]

# Course pages never existed as real courses; tell crawlers they are gone for good.
RewriteRule ^courses/.+ - [G,L]

# Keep the admin dashboard out of search results (the page also sets a robots meta tag).
SetEnvIf Request_URI "^/vc-portal-x7" VC_ADMIN
Header always set X-Robots-Tag "noindex, nofollow" env=VC_ADMIN
Header always set X-Robots-Tag "noindex, nofollow" env=REDIRECT_VC_ADMIN

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
