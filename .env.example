# Supabase project — powers the DB-authored blog (posts table + blog-images storage bucket).
# The anon key is safe to expose client-side; every write is gated by RLS policies that require
# an authenticated (signed-in) session.
VITE_SUPABASE_URL=https://sghuhnhylmalbuowggwk.supabase.co
VITE_SUPABASE_ANON_KEY=

# Phase 2 placeholders — not used in MVP
VITE_STRIPE_PUBLIC_KEY=
VITE_EMAILJS_KEY=

# Google AdSense — leave blank until the site is approved. AdSlot components
# (src/components/ads/AdSlot.tsx) render nothing in production until both the
# client ID and the relevant per-placement slot ID below are set.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_BLOG_POST_TOP=
VITE_ADSENSE_SLOT_BLOG_POST_BOTTOM=
VITE_ADSENSE_SLOT_BLOG_HUB=
